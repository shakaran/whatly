<services>
  <!--
    OBS source service for Whatly.

    obs_scm clones the tagged source WITH submodules enabled, so the bundled
    libnotify-qt submodule ends up in the tarball (the plain GitHub archive
    omits it). Run `osc service manualrun` locally, or let OBS run it, then
    commit the generated *.tar.gz next to whatly.spec.

    To bump the version, change <revision> to the new tag (e.g. v6.9.0); the
    version is derived automatically from the tag via @PARENT_TAG@.
  -->
  <service name="obs_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/shakaran/whatly.git</param>
    <param name="revision">v7.2.0</param>
    <param name="submodules">enable</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="filename">whatly</param>
  </service>

  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
</services>
