<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4/v5 source for the Whatly Windows .msi installer.

  Built in CI by the `windows` job of release-artifacts.yml, which passes:
    -d Version=<x.y.z>   the release version (from the tag)
    -d Src=build\Release the windeployqt output directory to package

  It harvests the whole deployed tree with <Files Include>, installs to
  "Program Files\Whatly" per machine, and adds Start Menu + Desktop shortcuts.
  The UpgradeCode is fixed so a newer .msi upgrades an older install in place.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Whatly"
           Manufacturer="Ángel Guzmán Maeso"
           Version="$(Version)"
           UpgradeCode="F425705D-B59A-4ABB-A4CA-4F5F01A8D594"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Whatly is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs icon, taken from the app executable. -->
    <Icon Id="whatly.exe" SourceFile="$(Src)\whatly.exe" />
    <Property Id="ARPPRODUCTICON" Value="whatly.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/shakaran/whatly" />

    <!-- Install location: Program Files\Whatly. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Whatly" />
    </StandardDirectory>
    <!-- Start Menu folder and the Desktop (standard) folder. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Whatly" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Whatly" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Harvest every file windeployqt produced (exe + all Qt/WebEngine DLLs,
         resources, translations) so the list never has to be maintained. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(Src)\**" />
    </ComponentGroup>

    <!-- Start Menu shortcut. HKLM keypath because the install is per-machine. -->
    <Component Id="StartMenuShortcut" Directory="AppShortcutFolder" Guid="*">
      <Shortcut Id="StartMenuWhatly"
                Name="Whatly"
                Target="[INSTALLFOLDER]whatly.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\Whatly" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopWhatly"
                Name="Whatly"
                Target="[INSTALLFOLDER]whatly.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\Whatly" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
